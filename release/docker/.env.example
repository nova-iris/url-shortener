# URL Shortener Application Configuration
# Copy this file to .env in the release directory and modify as needed

# Node.js environment: development, production, test
NODE_ENV=production

# Server port
PORT=5000

# MariaDB Configuration
# Root password for MariaDB (used for initial setup)
DB_ROOT_PASSWORD=rootpassword

# Database name
DB_NAME=urlshortener

# Application database user
DB_USER=urlshortener

# Application database password
DB_PASSWORD=urlshortener_password

# Database host - for docker compose this is the service name
DB_HOST=mariadb

# Database port - default is 3306
DB_PORT=3306

# Connection pool maximum size
DB_POOL_MAX=10

# Backend Public URL - This is used for:
# 1. Browser access to the backend API
# 2. Creating short URLs with the correct base URL
# For local development use: http://localhost:5000
# For production, use your domain, e.g.: https://api.example.com
BACKEND_PUBLIC_URL=http://localhost:5000

# Client configuration - the URL where the frontend is accessible
CLIENT_URL=http://localhost:4173

# =============================================================================
# Observability Configuration
# =============================================================================

# Logging Configuration
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Distributed Tracing (OpenTelemetry)
# Set to 'true' to enable tracing with Jaeger
# When enabled, start with: docker-compose --profile tracing up -d
ENABLE_TRACING=false

# OpenTelemetry OTLP endpoint for Jaeger
# Default points to the Jaeger service in docker-compose
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# Sampling rate for tracing (0.0 to 1.0)
# 0.1 = 10% of requests are traced (recommended for production)
# 1.0 = 100% of requests are traced (useful for development)
OTEL_SAMPLING_RATE=0.1